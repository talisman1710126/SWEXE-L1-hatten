<%= form_with model: book do |f| %>
  <% if book.errors.any? %>
    <div style="padding:10px 14px; margin-bottom:16px; background:#ffeef0; border:1px solid #d73a49; border-radius:6px; color:#86181d;">
      <p style="margin:0 0 6px; font-weight:bold;">
        <%= book.errors.count %>件の入力エラーがあります
      </p>
      <ul style="margin:0; padding-left:20px;">
        <% book.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "書名" %><br>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :author, "著者" %><br>
    <%= f.text_field :author %>
  </div>
  <div>
    <%= f.label :published_year, "出版年" %><br>
    <%= f.number_field :published_year %>
  </div>
  <div>
    <%= f.submit %>
  </div>
<% end %>
